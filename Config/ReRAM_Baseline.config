;================================================================================
; ReRAM Configuration with Dynamic Region-Based Mapping
; System Configuration: 8GB DDR3-1333 ReRAM
;================================================================================
; This configuration implements the dynamic virtual-to-physical memory mapping
; algorithm for ReRAM wear leveling and latency optimization.
;================================================================================

;================================================================================
; Interface specifications (DDR3-1333)
;================================================================================

CLK 667             ; DDR3-1333 = 667 MHz I/O clock (1333 MT/s)
RATE 2              ; DDR (double data rate)
BusWidth 64         ; 64-bit data bus
DeviceWidth 8       ; Each device contributes 8 bits
CPUFreq 2400        ; 2.4 GHz CPU frequency

;================================================================================
; Memory Organization
; Total: 8GB = 2 channels × 2 ranks × 8 banks × 64K rows × 4K columns
;================================================================================

CHANNELS 2          ; 2 channels
RANKS 2             ; 2 ranks per channel
BANKS 8             ; 8 banks per rank
ROWS 65536          ; 64K rows per bank (2^16 = 65536)
COLS 4096           ; 4K columns per row (2^12 = 4096)

; ReRAM Crossbar Array Organization
MATHeight 1024      ; 1024x1024 crossbar array (mat size)
; Calculated: 65536 rows / 1024 rows per mat = 64 mats per bank

;================================================================================
; Region-Based Mapping Configuration
;================================================================================

RegionSize 64               ; Rows per region (2^6 = 64)
; Calculated: 65536 rows / 64 = 1024 regions per bank
; Calculated: 1024 rows per mat / 64 = 16 regions per mat

FastRegionsPerMat 4         ; First 4 regions (256 rows) per mat are fast
; Total fast regions per bank: 64 mats × 4 FPRs = 256 FPRs
; Total slow regions per bank: 64 mats × 12 SPRs = 768 SPRs
; Fast region percentage: 256/1024 = 25%

;================================================================================
; Component Selection
;================================================================================

; Address translator with region mapping
AddressMappingScheme R:BK:RK:CH:C

Decoder ReRAMRegionMapper

; Memory controller with region scoring and migration
MEM_CTL ReRAMRegionController

; Bank with variable latency support
BankType ReRAMBank

; Interconnect
INTERCONNECT OnChipBus

;================================================================================
; DDR3-1333 Timing Parameters (in memory clock cycles @ 667 MHz)
; 1 cycle = 1.5 ns
;================================================================================

tBURST 4            ; 4-cycle burst (8 transfers for DDR)
tCMD 1              ; 1-cycle command
tRAS 24             ; Row access strobe time: ~36ns @ 667MHz
tRCD 11             ; Row-to-column delay: 13.5ns @ 667MHz ≈ 11 cycles
tCAS 11             ; CAS latency: CL=9 for DDR3-1333 ≈ 11 cycles
tRP 11              ; Precharge time: 13.5ns ≈ 11 cycles
tCCD 4              ; Column-to-column delay
tRTP 4              ; Read-to-precharge
tWR 10              ; Write recovery: 15ns ≈ 10 cycles
tCWD 4              ; CAS write delay
tRTRS 1             ; Rank-to-rank switching
tOST 1              ; ODT switching time
tRRDR 4             ; Row-to-row activation delay (same rank)
tRRDW 4             ; Row-to-row activation delay (different rank)
tFAW 27             ; Four-activation window: 40ns @ 667MHz ≈ 27 cycles
tWTR 5              ; Write-to-read delay: 7.5ns ≈ 5 cycles
tRTW 2              ; Read-to-write delay
tAL 0               ; Additive latency

; Refresh parameters
tRFC 120            ; Refresh cycle time: 180ns @ 667MHz ≈ 120 cycles
RefreshRows 1       ; Rows refreshed per refresh command
; Note: For ReRAM, refresh can be disabled if non-volatility is assumed

;================================================================================
; ReRAM-Specific Latencies (in nanoseconds)
; These override row access times based on physical region location
;================================================================================

FastRegionLatency 50        ; Write latency for near-end rows (FPR)
SlowRegionLatency 120       ; Write latency for far-end rows (SPR)

;================================================================================
; Region Scoring Algorithm Parameters
;================================================================================

Alpha 0.5                   ; Write score weight (α)
Beta 0.5                    ; Read score weight (β)
EpochLength 1000000         ; Migration decision interval: 1M cycles
MigrationThreshold 999999999      ; Min (S_max - S_min) to trigger swap

;================================================================================
; Energy Model (ReRAM typical values)
;================================================================================

EnergyModel energy

; Read/Write energy (in nanoJoules)
Erd 0.081200        ; Read energy per access
Ewr 1.684811        ; Write energy per access (SET/RESET)
Eopenrd 0.001616    ; Energy to activate row for read
Eclosed 0.000000    ; Energy when bank is idle (precharged)

; Leakage power (in milliWatts)
Eleak 3120.202      ; Leakage power per device

; DRAM-style energy parameters (for compatibility)
Eopen 0
Epdpf 0
Epdps 0
Epda 0
Eref 0

; Current specifications (mA) - typical for DDR3
EIDD0 85            ; Operating current (one bank active)
EIDD1 85            ; Precharge standby
EIDD2P0 20          ; Precharge power-down slow exit
EIDD2P1 42          ; Precharge power-down fast exit
EIDD2N 55           ; Precharge standby
EIDD3N 67           ; Active standby
EIDD3P 68           ; Active power-down
EIDD4R 207          ; Read burst current
EIDD4W 185          ; Write burst current
EIDD5B 230          ; Refresh burst current
EIDD6 22            ; Self-refresh current

;================================================================================
; Additional Configuration
;================================================================================

; No refresh needed for ReRAM (non-volatile)
UseRefresh false

; Queue configuration
QueueModel PerBankQueues    ; Separate queues per bank for better parallelism

; Print simulation statistics
PrintGraphs false
PrintPreTrace false

; Endurance model (optional for ReRAM wear-out tracking)
; EnduranceModel NullModel

; Decoder width (for address translation)
DecoderWidth 1      ; Single decoder per bank

; Command scheduling threshold
StarvationThreshold 4

;================================================================================
; Address Mapping Scheme Details
;================================================================================
; Physical Address decomposition (33 bits total):
;   PA[32:0] = [Row(16) | Bank(3) | Rank(1) | Channel(1) | Column(12)]
;
; Virtual Row Address (VRA) decomposition (16 bits):
;   VRA[15:0] = [VRN(10) | Region Offset(6)]
;
; Physical Row Address (PRA) decomposition (16 bits):
;   PRA[15:0] = [Mat Index(6) | Region in Mat(4) | Row in Region(6)]
;
; Address Translation Flow:
;   VA → PA (CPU MMU)
;   PA → VRA extraction (NVMain AddressTranslator)
;   VRA → VRN + RO (ReRAMRegionMapper)
;   VRN → PRN (Region Table lookup)
;   PRN + RO → PRA (Reconstruction)
;   PRA → Memory Bank
;================================================================================
